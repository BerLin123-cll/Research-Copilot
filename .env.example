# ============================================================
# 智研助手 (Research Copilot) 环境变量模板
# 复制为 .env 并按需修改： cp .env.example .env
# 生产部署（推荐）：Docker Compose 一键编排，PostgreSQL(pgvector) + 本地开源 Embedding
# 只需填写 LLM_API_KEY 即可跑通全部功能
# ============================================================

# ---------- 通用 ----------
APP_NAME=Research Copilot
APP_ENV=development            # development | production（Docker 部署由 compose 覆盖为 production）
DEBUG=true
# 允许的前端跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- LLM（OpenAI 兼容接口，默认 DeepSeek） ----------
# ★ 必填：申请地址 https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 对话温度
LLM_TEMPERATURE=0.3
# 生成报告时的最大输出 token
LLM_MAX_TOKENS=8192

# ---------- Embedding（默认本地开源免费，无需 Key） ----------
# local = fastembed 本地模型（推荐，零成本；Docker 构建时已预下载）
# openai = OpenAI 兼容 API（需填下方 EMBEDDING_API_KEY）
EMBEDDING_PROVIDER=local
# fastembed 支持的本地模型（免费开源；注意：fastembed 不支持 BAAI/bge-m3）：
#   BAAI/bge-small-zh-v1.5           512 维，中文轻量，CPU 快（默认）
#   intfloat/multilingual-e5-large   1024 维，多语言顶尖（含中文），效果优先
#   jinaai/jina-embeddings-v2-base-zh 768 维，中文优化、8192 token
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量维度：必须与 EMBEDDING_MODEL 匹配（bge-small-zh-v1.5=512，multilingual-e5-large=1024，jina-v2-base-zh=768）
# ★ 换模型后需同步修改本值，并删除已有向量表/重建数据库（维度不匹配会报错）
EMBEDDING_DIM=512
# --- 仅当 EMBEDDING_PROVIDER=openai 时需要以下配置 ---
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=text-embedding-3-small

# ---------- 数据库（PostgreSQL + pgvector，推荐） ----------
# 本地手动运行后端时按需修改 host/端口；Docker Compose 部署会自动覆盖为容器内地址
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research
# 同步 URL 仅 Alembic 迁移使用
SYNC_DATABASE_URL=postgresql+psycopg2://research:research@localhost:5432/research

# ---------- 向量库：pgvector（PostgreSQL 扩展，免费开源） ----------
# 无需额外配置：向量表 document_chunks 与 HNSW 索引由启动/迁移自动创建
# 使用 Docker 部署时只需 postgres 镜像（pgvector/pgvector:pg16）

# ---------- 研究 Agent 参数 ----------
# 最大搜索迭代轮数（信息不足时的重搜上限）
AGENT_MAX_ITERATIONS=3
# 单次网络搜索返回结果数
WEB_SEARCH_MAX_RESULTS=8
# 单次 arXiv 搜索返回论文数
ARXIV_MAX_RESULTS=5
# 网页抓取超时（秒）
FETCH_TIMEOUT=15
# 是否启用 Playwright 渲染动态页面（需额外安装 playwright + chromium）
PLAYWRIGHT_ENABLED=false
# 知识库检索返回 Top-K
RAG_TOP_K=5
# 文档分块参数
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# 是否将研究过程收集的资料自动写入知识库（供后续深度问答）
SAVE_RESEARCH_TO_KB=true
# 单个研究任务写入知识库的最大分块数
RESEARCH_KB_MAX_CHUNKS=30

# ---------- 搜索新鲜度 ----------
# DDG 时间过滤：空=不限 | d=一天内 | w=一周内 | m=一个月内 | y=一年内
# 建议对时效敏感场景设为 y（最近一年）
WEB_SEARCH_TIMELIMIT=
# 同时发起的 DuckDuckGo 搜索并发数上限（防止同 IP 被限流）
WEB_SEARCH_MAX_CONCURRENCY=2
# arXiv 排序：relevance=相关度 | submitted_date=最新提交优先 | updated_date=最近更新优先
ARXIV_SORT_BY=relevance

# ---------- 并发与超时 ----------
# 同时运行的研究任务上限（超出排队等待，状态保持 pending）
MAX_CONCURRENT_RESEARCH=3
# 单个研究任务整图执行看门狗超时（秒），超时标记为 failed
AGENT_TASK_TIMEOUT=900
# LLM 单次请求超时（秒）与失败重试次数（429/5xx 指数退避）
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 同步阻塞工具（DDG / arXiv）单次调用超时（秒）
TOOL_TIMEOUT=30

# ---------- 服务端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=8080
